# pySED input file
# Edit the paths, structure, and MD settings for your simulation.
# Manual: https://pysed.readthedocs.io/

# ==================== Control ====================
action = thinking  # compute | plot | fit | thinking (automatic workflow)
device = cpu       # cpu | gpu (CuPy); plotting and fitting use the CPU

# ==================== MD simulation ====================
num_atoms          = 40000   # Number of atoms in the trajectory
total_num_steps    = 300000  # Production MD steps, not saved frames
time_step          = 1       # MD integration time step, fs
output_data_stride = 15      # MD steps between saved frames

# ==================== Input / output ====================
# Input paths are relative to this file; outputs go to the working directory.
trajectory_file    = ../gpumd_run/dump.xyz  # Positions and velocities
basis_lattice_file = ../structure/basis.in # Atom-to-unit-cell mapping
out_files_name     = SrTiO3                # Output prefix

# ==================== Structure ====================
supercell_dim = 20 20 20
prim_unitcell = 3.89598 0 0  0 3.89598 0  0 0 3.89598  # Lattice vectors, angstrom
rescale_prim  = 1  # Reconstruct the primitive cell from the MD cell

# ==================== Q-points ====================
num_qpaths  = 5
q_path_name = GXMGRM  # G denotes Gamma; | separates disconnected path groups
# One fractional reciprocal-coordinate triple per label, excluding |.
q_path = 0.0 0.0 0.0  0.0 0.5 0.0  0.5 0.5 0.0  0.0 0.0 0.0  0.5 0.5 0.5  0.5 0.5 0.0

# ==================== Computation ====================
num_blocks     = 5  # Average SED over equal time blocks
max_cores      = 8  # CPU budget for computation and fitting
output_partial = 1  # Also save element/direction-resolved SED

# ==================== SED plot ====================
# plot_partial_SED = Sr y  # Optional element/direction selection
plot_cutoff_freq   = 25.0  # Maximum plotted frequency, THz
plot_interval      = 5.0   # Frequency-axis tick spacing, THz
qpoint_slice_index = 23    # Zero-based q-point index
plot_slice         = 1     # Also plot the selected q-point spectrum
if_show_figures    = 0     # 0: save only; 1: also display figures
# colorbar_min     = -20   # Optional lower color limit, natural-log scale
# colorbar_max     = -2    # Optional upper color limit, natural-log scale

# ==================== Spectral fitting ====================
lorentz_fit_all_qpoint        = 0     # 0: selected q-point; 1: all q-points
lorentz_fit_freq_min          = 0     # Minimum fitted frequency, THz
lorentz_fit_freq_max          = 25    # Maximum fitted frequency, THz
peak_min_significance         = 5.0   # Higher values reject more weak/noisy peaks
fitting_function             = auto  # auto | lorentz | dho
initial_guess_hwhm            = 0.01  # Initial peak HWHM, THz
re_output_total_freq_lifetime = 0     # 1: update the summary after refitting one q-point
